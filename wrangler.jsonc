{
  // Principal informations
  "name": "worker_name",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],

  // Secret Store bindings — injectés automatiquement par update-client-account
  // via wrangler deploy qui gère nativement le type secret_store_secret.
  // Remplacer "fc9ae3a7d41143acb136cca284e0c748" par l'ID du Secret Store du compte cible.
  "secrets_store_secrets": [
    {
      "binding": "MAIN_USERNAME",
      "store_id": "fc9ae3a7d41143acb136cca284e0c748",
      "secret_name": "MAIN_USERNAME"
    },
    {
      "binding": "MAIN_PASSWORD",
      "store_id": "fc9ae3a7d41143acb136cca284e0c748",
      "secret_name": "MAIN_PASSWORD"
    },
    {
      "binding": "TURNSTILE_SECRET_KEY",
      "store_id": "fc9ae3a7d41143acb136cca284e0c748",
      "secret_name": "TURNSTILE_SECRET_KEY"
    }
  ],

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}